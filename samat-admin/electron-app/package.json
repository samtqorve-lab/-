{
  "name": "samat-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "پنل ادمین صمت — نسخه‌ی دسکتاپ ویندوز",
  "main": "main.js",
  "scripts": {
    "prepare:web": "node scripts/copy-web-build.js",
    "start": "npm run prepare:web && electron .",
    "build:win": "npm run prepare:web && electron-builder --win",
    "build:win:publish": "npm run prepare:web && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^38.5.0",
    "electron-builder": "^26.0.15"
  },
  "dependencies": {
    "express": "^4.21.2",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "ir.novinproduct.samat-admin",
    "productName": "پنل ادمین صمت",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "samtqorve-lab",
      "repo": "-"
    }
  }
}
