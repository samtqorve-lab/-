{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samat-admin",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "novinproduct.ir", "custom_domain": true },
    { "pattern": "www.novinproduct.ir", "custom_domain": true }
  ]
}
