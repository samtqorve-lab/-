{
  "name": "samat-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "پنل ادمین سامات — نسخه‌ی دسکتاپ ویندوز",
  "main": "main.js",
  "scripts": {
    "prepare:web": "node scripts/copy-web-build.js",
    "start": "npm run prepare:web && electron .",
    "build:win": "npm run prepare:web && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.5.0",
    "electron-builder": "^26.0.15"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "build": {
    "appId": "ir.novinproduct.samat-admin",
    "productName": "پنل ادمین سامات",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
